{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fabric: Debug Client (select version)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "preLaunchTask": "Fabric: Debug Client JVM",
      "timeout": 120000
    },
    {
      "name": "Fabric: Debug Server (select version)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "preLaunchTask": "Fabric: Debug Server JVM",
      "timeout": 120000
    }
  ],
  "inputs": [
    {
      "id": "minecraftVersion",
      "type": "pickString",
      "description": "Minecraft version to test",
      "default": "1.21.1",
      "options": ["1.21", "1.21.1"]
    }
  ]
}
